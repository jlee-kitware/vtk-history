# Copy to .env and edit; .env is ignored by git. Relative paths are taken from the repository root.

# A VTK clone with the upstream remote (https://gitlab.kitware.com/vtk/vtk.git) fetched.
VTK_REPO=../vtk

# Ollama server for local models (qwen3-coder-next, gpt-oss) and embeddings (qwen3-embedding).
OLLAMA_HOST=http://localhost:11434

# Scratch worktree and build directory for the developer checks (agent/dev_checks.py).
VTK_REVIEW_WORKTREE=../vtk-review-wt
VTK_REVIEW_BUILD=../vtk-review-build

# Only for mirroring GitLab: a read_api token from an account with no project memberships.
GITLAB_TOKEN=

# Only for the OpenAI experiments.
OPENAI_API_KEY=
